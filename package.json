{
  "name": "obsidian-bamboo-review",
  "version": "3.32.6",
  "description": "竹林修仙传 - Obsidian 每日复盘插件",
  "main": "main.js",
  "scripts": {
    "dev": "npm run build:webapp && tsc --noEmit && node esbuild.config.mjs",
    "build": "npm run build:webapp && tsc --noEmit -skipLibCheck && npm run lint && npm run lint:css && npm run check:html-escape && npm run check:dead-css && npm run check:dead-exports && node esbuild.config.mjs production",
    "build:webapp": "node scripts/bundle-webapp.mjs",
    "test": "jest",
    "test:coverage": "COVERAGE_EVAL=1 jest",
    "check:message-contract": "node scripts/check-message-contract.mjs",
    "check:message-coverage": "node scripts/check-message-coverage.mjs",
    "check:window-globals": "node scripts/check-window-globals.mjs",
    "check:review-rules": "node scripts/check-review-rules.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
  "check:release-drift": "node scripts/check-release-drift.mjs",
  "check:release-drift:strict": "node scripts/check-release-drift.mjs --strict",
    "preflight": "npm run lint && npm run lint:css && tsc --noEmit && node scripts/check-load-matrix.mjs && node scripts/check-message-contract.mjs && node scripts/check-message-coverage.mjs && node scripts/check-window-globals.mjs && node scripts/check-review-rules.mjs && node scripts/check-dead-css.mjs && node scripts/check-dead-exports.mjs && node scripts/check-dead-methods.mjs && node scripts/check-actions.mjs && node scripts/check-architecture.mjs && node scripts/check-release-drift.mjs",
    "coverage:baseline": "COVERAGE_EVAL=1 COVERAGE_UPDATE_BASELINE=1 jest",
    "test:host": "vitest run",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:css": "node scripts/lint-css-tokens.mjs",
    "check:load-matrix": "node scripts/check-load-matrix.mjs",
    "check:dead-css": "node scripts/check-dead-css.mjs",
    "check:dead-exports": "node scripts/check-dead-exports.mjs",
    "check:html-escape": "node scripts/check-html-escape.mjs",
    "check:html-escape:report": "node scripts/check-html-escape.mjs --report",
    "check:html-escape:self-test": "node scripts/check-html-escape.mjs --self-test",
    "format": "prettier --write \"src/**/*.ts\" \"webapp/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"webapp/**/*.js\"",
    "prepare": "husky || true",
    "check:dead-methods": "node scripts/check-dead-methods.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "obsidian": "^1.8.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
